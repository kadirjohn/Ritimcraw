<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ritimcraw">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ritimcraw"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <!-- Orientation state preservation (owner request 2026-11-11d
                 sections 17.3 + 18: "Do not reset editing state or playback
                 when switching orientation"): MainActivity opts into handling
                 the orientation change itself, so the system does NOT
                 recreate the activity on rotation. Compose's
                 LocalConfiguration still updates in place through
                 AndroidComposeView.onConfigurationChanged (the editor reads
                 screenWidthDp/screenHeightDp from it every recomposition —
                 OrientationLayout re-splits the workspace responsively), and
                 every remember(sourceId) block — the render session,
                 decoder, playback position, grade, panel and scroll state —
                 simply keeps living: no recreation, no reprocessing, no
                 re-decode. The rememberSaveable states (tab, panelState,
                 per-category scrolls, fullscreen, histogram) remain the
                 safety net for process death and the rare recreation
                 (system-initiated relaunch, don't-keep-activities). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Own exports through content:// (owner request 2026-11-11 §1): a
             DONE row whose media-store publish failed still opens, through
             FileProvider with a temporary read grant — the file never leaves
             files/exports, only a read window on it is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ritim.ritimcraw.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:value="@xml/export_paths" />
        </provider>
    </application>

</manifest>