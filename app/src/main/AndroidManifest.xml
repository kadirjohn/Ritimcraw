<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Export foreground service (owner finding 2026-11-14: Android's
         OomAdjuster moved the app to the cached state and FROZE the
         process mid-export once the owner backgrounded it — a 1749-frame
         render died silently). While an export is RUNNING the app holds
         the process at foreground priority through a dataSync foreground
         service; the permissions targetSdk 36 makes mandatory for that
         type. POST_NOTIFICATIONS: the service's priority works without
         it, but the progress notification (the visible side of the
         priority) needs the grant — declaring it lets the user give it;
         the runtime request itself is UI work, out of this change. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".export.ExportApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ritimcraw">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ritimcraw"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <!-- Orientation state preservation (owner request 2026-11-11d
                 sections 17.3 + 18: "Do not reset editing state or playback
                 when switching orientation"): MainActivity opts into handling
                 the orientation change itself, so the system does NOT
                 recreate the activity on rotation. Compose's
                 LocalConfiguration still updates in place through
                 AndroidComposeView.onConfigurationChanged (the editor reads
                 screenWidthDp/screenHeightDp from it every recomposition —
                 OrientationLayout re-splits the workspace responsively), and
                 every remember(sourceId) block — the render session,
                 decoder, playback position, grade, panel and scroll state —
                 simply keeps living: no recreation, no reprocessing, no
                 re-decode. The rememberSaveable states (tab, panelState,
                 per-category scrolls, fullscreen, histogram) remain the
                 safety net for process death and the rare recreation
                 (system-initiated relaunch, don't-keep-activities). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Export foreground service (owner finding 2026-11-14): holds the
             process at foreground priority while an export is RUNNING, so
             the process is never moved to the cached state and frozen
             mid-render. dataSync is the honest type — an export writes its
             output file for the job's duration. Started and stopped by the
             export queue's own state transitions (RUNNING start, terminal
             stop); the service never outlives the job. -->
        <service
            android:name=".export.ExportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Proxy foreground service (G3, docs/PROXY_PLAN.md section 4): the
             same owner finding and the same shape as the export service —
             a background proxy build takes minutes (8K decode + downscale +
             encode) and a frozen process would leave a half .tmp the
             never-half rule discards, so the build holds the process at
             foreground priority for its own duration. Started and stopped
             by the proxy queue's own state transitions; never outlives the
             build. -->
        <service
            android:name=".proxy.ProxyForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Own exports through content:// (owner request 2026-11-11 §1): a
             DONE row whose media-store publish failed still opens, through
             FileProvider with a temporary read grant — the file never leaves
             files/exports, only a read window on it is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ritim.ritimcraw.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:value="@xml/export_paths" />
        </provider>
    </application>

</manifest>