  "fix: live export status and real progress",
  "fix: queue input size and verify mp4 output",
  "feat: open finished exports from the list",
  "feat: clip display names",
  "merge: editor modernization, lut, noise, audio",
  "feat: full resolution pause and clip info"
 ],
